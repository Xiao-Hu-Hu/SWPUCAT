# Server
CSA_SERVER_PORT=8080
CSA_SERVER_MODE=debug

# Database
CSA_DATABASE_HOST=localhost
CSA_DATABASE_PORT=5432
CSA_DATABASE_USER=csa
CSA_DATABASE_PASSWORD=change-me-in-production
CSA_DATABASE_DBNAME=csa_db
CSA_DATABASE_SSLMODE=disable

# Redis
CSA_REDIS_ADDR=localhost:6379
CSA_REDIS_PASSWORD=
CSA_REDIS_DB=0

# JWT
CSA_JWT_ACCESS_SECRET=change-me-to-random-32-bytes-min
CSA_JWT_REFRESH_SECRET=change-me-to-random-32-bytes-min

# Log
CSA_LOG_LEVEL=debug
CSA_LOG_FORMAT=console
