# 数据库（Compose 和 Go 服务共用）
CSA_DATABASE_HOST=localhost
CSA_DATABASE_PORT=5432
CSA_DATABASE_USER=csa
CSA_DATABASE_PASSWORD=change-me
CSA_DATABASE_DBNAME=csa_db
CSA_DATABASE_SSLMODE=disable
CSA_DATABASE_MAX_OPEN_CONNS=15
CSA_DATABASE_MAX_IDLE_CONNS=3
# 仅用于没有 schema_migrations、且已经完成旧版 001-015 结构的数据库升级。
# 全新数据库必须保持 false；旧库应先备份，再设置为 true 执行一次迁移。
CSA_MIGRATION_BASELINE=false

# JWT（请使用随机生成且彼此不同的长字符串）
CSA_JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
CSA_JWT_REFRESH_SECRET=change-me-to-another-random-string-at-least-32-chars

# 服务
CSA_SERVER_MODE=release
CSA_LOG_LEVEL=info
TZ=Asia/Shanghai

# 文件
CSA_STORAGE_UPLOAD_DIR=./uploads
CSA_STORAGE_MAX_FILE_SIZE=104857600

# SMTP（可选；不配置时验证码邮件功能不可用）
CSA_EMAIL_SMTP_HOST=
CSA_EMAIL_SMTP_PORT=587
CSA_EMAIL_USERNAME=
CSA_EMAIL_PASSWORD=
CSA_EMAIL_FROM=

# Agent / Eino（第二阶段启用；密钥只注入 Agent 容器）
CSA_AGENT_ENABLED=false
CSA_AGENT_WRITE_ENABLED=false
CSA_AGENT_BASE_URL=http://agent:8090
CSA_SERVER_INTERNAL_URL=http://server:8080
CSA_AGENT_INTERNAL_SECRET=change-me-to-a-random-internal-secret
CSA_LLM_PROVIDER=openai_compatible
CSA_LLM_MODEL=
CSA_LLM_API_KEY=
CSA_LLM_BASE_URL=
CSA_LLM_TIMEOUT=60s
CSA_AGENT_MAX_ITERATIONS=4
CSA_AGENT_MAX_TOOL_CALLS=8
CSA_AGENT_WORKER_CONCURRENCY=1

# 向量检索。嵌入模型可使用独立的 OpenAI-compatible 服务；不要假设聊天模型支持 /embeddings。
# 启用后将 CSA_RETRIEVAL_MODE 设为 hybrid 或 vector，并填写模型实际向量维度。
CSA_EMBEDDING_ENABLED=false
CSA_EMBEDDING_PROVIDER=openai_compatible
CSA_EMBEDDING_MODEL=
CSA_EMBEDDING_API_KEY=
CSA_EMBEDDING_BASE_URL=
CSA_EMBEDDING_DIMENSIONS=1024
CSA_EMBEDDING_BATCH_SIZE=16
CSA_EMBEDDING_TIMEOUT=30s

# 检索与文件切片。embedding 未启用时必须使用 keyword。
CSA_RETRIEVAL_MODE=keyword
CSA_RETRIEVAL_CANDIDATE_LIMIT=20
CSA_RETRIEVAL_FINAL_LIMIT=8
CSA_RETRIEVAL_MIN_VECTOR_SCORE=0.3
CSA_RETRIEVAL_CHUNK_RUNES=600
CSA_RETRIEVAL_CHUNK_OVERLAP_RUNES=80
CSA_RETRIEVAL_MAX_EXTRACTED_RUNES=500000
CSA_RETRIEVAL_WORKER_INTERVAL=5s
